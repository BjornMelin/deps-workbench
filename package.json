{
  "name": "deps-workbench",
  "version": "0.1.0",
  "description": "Bun-native dependency upgrade preparation and analysis workbench.",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "biome:check": "bunx --bun @biomejs/biome check .",
    "biome:write": "bunx --bun @biomejs/biome check --write .",
    "biome:ci": "bunx --bun @biomejs/biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run biome:ci && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "zod": "^4.3.6"
  }
}
