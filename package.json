{
  "name": "deps-workbench",
  "version": "0.1.0",
  "description": "Bun-native dependency upgrade preparation and analysis workbench.",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "biome:write:staged": "biome check --write --staged .",
    "biome:ci": "biome ci .",
    "hook:pre-commit-format": "bun run src/hooks/pre-commit-format.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run biome:ci && bun run typecheck && bun run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/bun": "1.3.12",
    "@types/semver": "^7.7.1",
    "husky": "^9.1.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <6.0.0"
  },
  "dependencies": {
    "@openai/agents": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.7.4",
    "zod": "^4.3.6"
  }
}
