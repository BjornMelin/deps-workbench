#!/usr/bin/env sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

STASH_REF=""

restore_unstaged_changes() {
  if [ -n "$STASH_REF" ] &&
    git rev-parse -q --verify "$STASH_REF" >/dev/null 2>&1; then
    git stash apply --quiet "$STASH_REF" >/dev/null || {
      echo "Failed to restore unstaged changes after pre-commit" >&2
      exit 1
    }
    git stash drop --quiet "$STASH_REF" >/dev/null || {
      echo "Failed to drop temporary pre-commit stash" >&2
      exit 1
    }
    STASH_REF=""
  fi
}

stash_unstaged_changes() {
  if git diff --quiet --ignore-submodules -- &&
    [ -z "$(git ls-files --others --exclude-standard)" ]; then
    return
  fi

  git stash push --keep-index --include-untracked --quiet --message "deps-workbench-pre-commit" >/dev/null
  STASH_REF="stash@{0}"
}

trap 'status=$?; restore_unstaged_changes; exit $status' EXIT HUP INT TERM

stash_unstaged_changes
bun run hook:pre-commit-format

bun run typecheck
bun run test

trap - EXIT HUP INT TERM
restore_unstaged_changes
