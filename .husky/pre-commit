#!/usr/bin/env sh
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

# Paths already staged for this commit (Biome only touches these with --staged).
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

bun run biome:write:staged

# Put formatter/linter fixes back into the index so the commit includes them.
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | while IFS= read -r path; do
    [ -z "$path" ] && continue
    git add -- "$path"
  done
fi

bun run typecheck
bun run test
